# Parento Backend — local configuration template
# Copy to .env for local development. Never commit .env.

NODE_ENV=development
APP_NAME=parento-backend
HOST=127.0.0.1
PORT=3000
API_BASE_PATH=/api/v1

# Future database connection. Required in production.
DATABASE_URL=

LOG_LEVEL=info
LOG_PRETTY=true

# Comma-separated explicit origins. Do not use * in production.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false

# Future authentication/session configuration. Authentication is not implemented in Phase 1.3.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400

REQUEST_BODY_LIMIT=100kb
TRUST_PROXY=false

RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

REALTIME_ENABLED=false

# Comma-separated serviceName=https://example.invalid entries.
EXTERNAL_SERVICE_BASE_URLS=
