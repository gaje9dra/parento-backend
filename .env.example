# Parento Backend — local configuration template
# Copy to .env for local development. Never commit .env.

NODE_ENV=development
APP_NAME=parento-backend
HOST=127.0.0.1
PORT=3000
API_BASE_PATH=/api/v1

# PostgreSQL connection. Required in production and for persistence integration tests.
DATABASE_URL=

LOG_LEVEL=info
LOG_PRETTY=true

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false

JWT_ISSUER=
JWT_AUDIENCE=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=86400

ENROLLMENT_SESSION_TTL_SECONDS=900
ENROLLMENT_VERIFICATION_MAX_ATTEMPTS=10
ENROLLMENT_VERIFICATION_WINDOW_MS=60000
ENROLLMENT_VERIFICATION_MAX_REQUESTS=10

# Phase 6.1 secure communication foundation.
DEVICE_SESSION_TTL_SECONDS=900
COMMAND_TTL_SECONDS=300
COMMAND_MAX_TTL_SECONDS=3600

REQUEST_BODY_LIMIT=100kb
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_SSL=false
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
TRUST_PROXY=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

REALTIME_ENABLED=false

EXTERNAL_SERVICE_BASE_URLS=
