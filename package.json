{
  "name": "parento-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend foundation for the Parento authorized Android device-management platform.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write tests/enrollment-session.integration.test.ts && git diff -- tests/enrollment-session.integration.test.ts && prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run audit",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:status": "tsx src/db/migrate.ts status",
    "db:reset": "tsx src/db/migrate.ts reset"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.8",
    "pg": "^8.23.0",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/pg": "^8.23.1"
  }
}
